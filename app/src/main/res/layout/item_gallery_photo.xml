<?xml version="1.0" encoding="utf-8"?>
<!-- Una foto de la galería. El ancho se fija en el adapter al ancho del
     RecyclerView, para que cada foto ocupe una "página" y el snap funcione. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="wrap_content"
    android:layout_height="match_parent"
    android:background="#EEEEEE">

    <ImageView
        android:id="@+id/ivGalleryPhoto"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="centerCrop"
        android:contentDescription="@string/detail_description_label" />

</FrameLayout>

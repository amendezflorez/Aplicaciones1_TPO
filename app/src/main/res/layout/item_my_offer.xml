<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="12dp"
    android:layout_marginVertical="6dp"
    app:cardCornerRadius="10dp"
    app:cardElevation="3dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="14dp">

        <TextView
            android:id="@+id/tvMyOfferTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textStyle="bold"
            android:textColor="@android:color/black"
            android:textSize="16sp"
            tools:text="Bicicleta Mountain Bike" />

        <TextView
            android:id="@+id/tvMyOfferCounterpart"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:textColor="#757575"
            android:textSize="12sp"
            tools:text="Vendedor: Ana Gómez" />

        <TextView
            android:id="@+id/tvMyOfferAmount"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:textColor="#2E7D32"
            android:textStyle="bold"
            android:textSize="15sp"
            tools:text="Ofertaste $ 140000.00 (precio publicado $ 150000.00)" />

        <TextView
            android:id="@+id/tvMyOfferMessage"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:textColor="#616161"
            android:textSize="13sp"
            android:visibility="gone"
            tools:visibility="visible"
            tools:text="¿Lo dejarías en 140000?" />

        <TextView
            android:id="@+id/tvMyOfferStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:paddingHorizontal="8dp"
            android:paddingVertical="3dp"
            android:textSize="11sp"
            android:textStyle="bold"
            tools:text="PENDIENTE" />

        <LinearLayout
            android:id="@+id/containerMyOfferActions"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btnMyOfferAccept"
                style="@style/Widget.Material3.Button.TonalButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:textSize="11sp"
                android:text="@string/offer_action_accept" />

            <Button
                android:id="@+id/btnMyOfferReject"
                style="@style/Widget.Material3.Button.TonalButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="4dp"
                android:textSize="11sp"
                android:text="@string/offer_action_reject" />

            <Button
                android:id="@+id/btnMyOfferCounter"
                style="@style/Widget.Material3.Button.TonalButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="4dp"
                android:textSize="11sp"
                android:text="@string/offer_action_counter" />

        </LinearLayout>

    </LinearLayout>
</androidx.cardview.widget.CardView>

<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:paddingVertical="8dp"
    android:paddingHorizontal="4dp">

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tvOfferUserAndAmount"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="14sp"
            android:textStyle="bold"
            android:textColor="@android:color/black" />

        <TextView
            android:id="@+id/tvOfferDeliveryPoint"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:textSize="12sp"
            android:textColor="#2E7D32"
            android:visibility="gone" />

    </LinearLayout>

    <Button
        android:id="@+id/btnAcceptOffer"
        style="@style/Widget.MaterialComponents.Button.OutlinedButton"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/detail_accept_offer"
        android:textSize="12sp" />

    <TextView
        android:id="@+id/tvOfferAcceptedBadge"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/detail_offer_accepted_badge"
        android:textColor="#2E7D32"
        android:textStyle="bold"
        android:textSize="13sp"
        android:padding="6dp"
        android:visibility="gone" />

</LinearLayout>
